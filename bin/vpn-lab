#!/usr/bin/env bash

set -euo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/vpn-lab.env"

if [[ ! -r "$CONFIG" ]]; then
    echo "Configuration VPN introuvable : $CONFIG" >&2
    exit 1
fi

source "$CONFIG"

: "${REMOTE_HOST:?REMOTE_HOST manquant dans vpn-lab.env}"
: "${LOGIN:?LOGIN manquant dans vpn-lab.env}"

sudo killall -9 charon-cmd 2>/dev/null || true
sudo ip xfrm state flush 2>/dev/null || true
sudo ip xfrm policy flush 2>/dev/null || true
sleep 1

sudo charon-cmd --host "$REMOTE_HOST" \
    --identity "$LOGIN" \
    --remote-identity %any \
    --ike-proposal "aes128-sha256-ecp384" \
    --profile ikev2-eap
