[global]
transparency = 4
separator_color = frame
frame_width = 2
frame_color = "#119da4" 

[urgency_low]
    background = "#222222"
    foreground = "#d7d9ceff"
    timeout = 5

[urgency_normal]
    background = "#222222"
    foreground = "#d7d9ceff"
    frame_color = "#119da4"
    timeout = 10

[urgency_critical]
    background = "#222222"
    foreground = "#f8edeb"
    frame_color = "#bf616a"
    timeout = 0
