@define-color color_bg rgba(22, 22, 22, 0.95);
@define-color color_module_bg rgba(45, 45, 45, 1);
@define-color color_fg #d7d9ce;
@define-color color_accent #119da4; 
@define-color color_highlight #0c7489; 
@define-color color_inactive #7f849c;

window#waybar {
    background-color: transparent;
    border: none;
}

.modules-left,
.modules-center,
.modules-right {
    background-color: @color_bg;
    border: 2px solid @color_bg;
    border-radius: 14px;
    padding: 2px 10px;
    margin: 5px;
}

#waybar {
    background: @color_bg;
    box-shadow: none;
    border: 2px solid @color_bg; 
    border-radius: 14px;
    transition: 0.2s; 
}

#waybar:hover {
    border: 2px solid @color_accent;
}

* {
    font-family: "Hack Nerd Font", "Noto Color Emoji";
    font-size: 14px;
    color: @color_fg;
}

.capsule {
    background: transparent;
    padding: 4px 8px;
    margin: 4px 0px; 
    border-radius: 14px;
    border: 2px solid @color_bg;
    transition: 0.2s;
}

.capsule:hover {
    background: rgba(45, 45, 45, 0.7); 
    border: 2px solid @color_accent;
}

.capsule.center {
    padding: 4px 20px;
    border-radius: 20px;
}

#hyprland-workspaces {
    background: @color_module_bg; 
    padding: 4px 12px;
    border-radius: 14px;
    margin: 4px 6px;
    border: 2px solid @color_module_bg;
    transition: 0.2s;
}

#hyprland-workspaces:hover {
    border: 2px solid @color_accent;
}

#hyprland-workspaces button {
    background: transparent;
    color: @color_inactive;
    margin: 0 3px;
    padding: 4px 10px 4px 5px;
    border-radius: 10px;
    transition: 0.2s ease;
    min-width: 24px;
}

#hyprland-workspaces button.active {
    background: @color_accent; 
    color: @color_bg; 
}

#hyprland-workspaces button:hover {
    color: @color_accent;
    background: transparent;
}

#hyprland-window {
    background: @color_module_bg;
    color: @color_accent;
    padding: 4px 12px;
    border-radius: 14px;
    margin: 4px 0;
    border: 2px solid @color_module_bg;
    transition: 0.2s;
}

#hyprland-window:hover {
    border: 2px solid @color_accent;
}

#cpu { color: #f38ba8; } 
#memory { color: #fab387; } 
#network { color: #94e2d5; } 
#pulseaudio { color: #a6e3a1; } 
#clock {
    color: #cba6f7; 
    padding: 4px 16px 4px 8px;
}
#tray { color: @color_fg; }
#battery {
    color: #ffffff;
}
#battery.warning {
    color: orange;
}
#battery.critical {
    color: red;
}
#battery.charging {
    color: #4caf50;
}
