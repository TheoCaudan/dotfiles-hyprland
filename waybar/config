{
  "layer": "top",
  "position": "top",
  "height": 28,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "modules-left": [
    "hyprland/workspaces",
    "custom/cava",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "battery",
    "tray"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": ""
    },
    "on-click": "hyprctl dispatch workspace {id}",
    "persistent-workspaces": {
      "*": 5
    }
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 30,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": "  $1",
      "(.*) - Twitch — Mozilla Firefox": "  $1",
      "(.*) - Youtube — Mozilla Firefox": "  $1",
      "(.*) - Discord": "  $1",
      "Spotube": "󰓇  Spotube"
    }
  },
  "custom/cava": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/cava.sh",
    "on-click": "eww open --toggle media-menu"
  },
  "clock": {
    "format": " {:%H:%M}",
    "format-alt": " {:%a %b %d}",
    "tooltip-format": "{calendar}"
  },
  "cpu": {
    "format": "󰍛 {usage}%"
  },
  "memory": {
    "format": " {used}GB"
  },
  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": " ETH",
    "format-disconnected": " "
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " MUTED",
    "format-icons": {
      "default": [
        "",
        ""
      ]
    },
    "scroll-step": 2
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  }
}
