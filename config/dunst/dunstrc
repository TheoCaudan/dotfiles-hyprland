[global]
transparency = 4
separator_color = frame
frame_width = 1
frame_color = "#119da4" 
progress_bar = true
progress_bar_height = 8
progress_bar_frame_width = 1
progress_bar_min_width = 150
progress_bar_max_width = 300
progress_bar_corner_radius = 4

[urgency_low]
    background = "#222222ff"
    foreground = "#d7d9ceff"
    highlight = "#119da4"
    timeout = 3

[urgency_normal]
    background = "#222222ff"
    foreground = "#d7d9ceff"
    highlight = "#119da4"
    frame_color = "#119da4"
    timeout = 5 

[urgency_critical]
    background = "#222222ff"
    foreground = "#f8edeb"
    highlight = "#119da4"
    frame_color = "#bf616a"
    timeout = 15
